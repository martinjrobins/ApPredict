<?xml version='1.0' encoding='UTF-8'?>
<model xmlns="http://www.cellml.org/cellml/1.0#" xmlns:cellml="http://www.cellml.org/cellml/1.0#" xmlns:cmeta="http://www.cellml.org/metadata/1.0#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" name="tentusscher_2006">
  <units name="A_per_F">
    <unit units="gram" multiplier="1000"/>
    <unit units="metre" exponent="2.0"/>
    <unit units="second" exponent="-4.0"/>
    <unit units="ampere" exponent="-1.0"/>
  </units>
  <units name="C_per_mmol">
    <unit units="second" multiplier="1000"/>
    <unit units="ampere"/>
    <unit units="mole" exponent="-1.0"/>
  </units>
  <units name="J_per_mol_per_K">
    <unit units="gram" multiplier="1000"/>
    <unit units="metre" exponent="2.0"/>
    <unit units="second" exponent="-2.0"/>
    <unit units="kelvin" exponent="-1.0"/>
    <unit units="mole" exponent="-1.0"/>
  </units>
  <units name="m6_per_mol2">
    <unit units="metre" exponent="6.0"/>
    <unit units="mole" exponent="-2.0"/>
  </units>
  <units name="mM">
    <unit units="metre" exponent="-3.0"/>
    <unit units="mole"/>
  </units>
  <units name="mM2">
    <unit units="metre" exponent="-6.0"/>
    <unit units="mole" exponent="2.0"/>
  </units>
  <units name="mM3">
    <unit units="metre" exponent="-9.0"/>
    <unit units="mole" exponent="3.0"/>
  </units>
  <units name="mM_per_ms">
    <unit units="metre" exponent="-3.0" multiplier="1000"/>
    <unit units="second" exponent="-1.0"/>
    <unit units="mole"/>
  </units>
  <units name="mS_per_uF">
    <unit units="second" exponent="-1.0" multiplier="1000"/>
  </units>
  <units name="mV">
    <unit units="gram"/>
    <unit units="metre" exponent="2.0"/>
    <unit units="second" exponent="-3.0"/>
    <unit units="ampere" exponent="-1.0"/>
  </units>
  <units name="ms">
    <unit units="second" multiplier="0.001"/>
  </units>
  <units name="s_mol_per_m3_times_1e_minus_3">
    <unit units="metre" exponent="-3.0" multiplier="0.001"/>
    <unit units="second"/>
    <unit units="mole"/>
  </units>
  <units name="uF">
    <unit units="gram" exponent="-1.0" multiplier="1e-09"/>
    <unit units="metre" exponent="-2.0"/>
    <unit units="second" exponent="4.0"/>
    <unit units="ampere" exponent="2.0"/>
  </units>
  <units name="um3">
    <unit units="metre" exponent="3.0" multiplier="1e-18"/>
  </units>
  <component name="calcium">
    <variable name="Buf_c" units="mM" initial_value="0.2"/>
    <variable name="Buf_sr" units="mM" initial_value="10.0"/>
    <variable name="Buf_ss" units="mM" initial_value="0.4"/>
    <variable name="Ca_i" units="mM" public_interface="out" initial_value="1.05782268600543037e-04"/>
    <variable name="Ca_i_bufc" units="mM2"/>
    <variable name="Ca_sr" units="mM" initial_value="3.55567791655852350"/>
    <variable name="Ca_sr_bufsr" units="mM2"/>
    <variable name="Ca_ss" units="mM" public_interface="out" initial_value="2.14172873269809840e-04"/>
    <variable name="Ca_ss_bufss" units="mM2"/>
    <variable name="Cm" units="uF" public_interface="in"/>
    <variable name="EC" units="mM" initial_value="1.5"/>
    <variable name="F" units="C_per_mmol" public_interface="in"/>
    <variable name="ICaB" units="A_per_F" public_interface="in"/>
    <variable name="ICaL" units="A_per_F" public_interface="in"/>
    <variable name="INaCa" units="A_per_F" public_interface="in"/>
    <variable name="IpCa" units="A_per_F" public_interface="in"/>
    <variable name="ItCa" units="A_per_F" public_interface="out"/>
    <variable name="K_buf_c" units="mM" initial_value="0.001"/>
    <variable name="K_buf_sr" units="mM" initial_value="0.3"/>
    <variable name="K_buf_ss" units="mM" initial_value="0.00025"/>
    <variable name="K_up" units="mM" initial_value="0.00025"/>
    <variable name="O" units="dimensionless"/>
    <variable name="R_prime" units="s_mol_per_m3_times_1e_minus_3" initial_value="9.89066126100902498e-01"/>
    <variable name="V_leak" units="mS_per_uF" initial_value="0.00036"/>
    <variable name="V_rel" units="mS_per_uF" initial_value="0.102" cmeta:id="calcium_V_rel"/>
    <variable name="V_sr" units="um3" initial_value="0.001094"/>
    <variable name="V_ss" units="um3" initial_value="5.468e-05"/>
    <variable name="V_xfer" units="mS_per_uF" initial_value="0.0038"/>
    <variable name="Vc" units="um3" public_interface="in"/>
    <variable name="Vmax_up" units="mM_per_ms" initial_value="0.006375"/>
    <variable name="calcium_O_k1" units="dimensionless"/>
    <variable name="calcium_O_k3" units="mS_per_uF" initial_value="0.06"/>
    <variable name="calcium_R_prime_k2" units="dimensionless"/>
    <variable name="calcium_R_prime_k4" units="mS_per_uF" initial_value="0.005"/>
    <variable name="i_leak" units="mM"/>
    <variable name="i_rel" units="mM"/>
    <variable name="i_up" units="mM2"/>
    <variable name="i_xfer" units="mM"/>
    <variable name="k1_prime" units="dimensionless" initial_value="0.15"/>
    <variable name="k2_prime" units="dimensionless" initial_value="0.045"/>
    <variable name="kcasr" units="mM2"/>
    <variable name="max_sr" units="dimensionless" initial_value="2.5"/>
    <variable name="min_sr" units="dimensionless" initial_value="1.0"/>
    <variable name="time" units="ms" public_interface="in"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>time</ci>
          </bvar>
          <ci>Ca_i</ci>
        </apply>
        <apply>
          <times/>
          <ci>Ca_i_bufc</ci>
          <apply>
            <minus/>
            <apply>
              <plus/>
              <apply>
                <divide/>
                <apply>
                  <times/>
                  <apply>
                    <minus/>
                    <ci>i_leak</ci>
                    <ci>i_up</ci>
                  </apply>
                  <ci>V_sr</ci>
                </apply>
                <ci>Vc</ci>
              </apply>
              <ci>i_xfer</ci>
            </apply>
            <apply>
              <divide/>
              <apply>
                <times/>
                <apply>
                  <minus/>
                  <ci>ItCa</ci>
                  <ci>ICaL</ci>
                </apply>
                <ci>Cm</ci>
              </apply>
              <apply>
                <times/>
                <apply>
                  <times/>
                  <cn cellml:units="dimensionless">2.0</cn>
                  <ci>Vc</ci>
                </apply>
                <ci>F</ci>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>Ca_i_bufc</ci>
        <apply>
          <divide/>
          <cn cellml:units="dimensionless">1.0</cn>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1.0</cn>
            <apply>
              <divide/>
              <apply>
                <times/>
                <ci>Buf_c</ci>
                <ci>K_buf_c</ci>
              </apply>
              <apply>
                <power/>
                <apply>
                  <plus/>
                  <ci>Ca_i</ci>
                  <ci>K_buf_c</ci>
                </apply>
                <cn cellml:units="dimensionless">2.0</cn>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>time</ci>
          </bvar>
          <ci>Ca_sr</ci>
        </apply>
        <apply>
          <times/>
          <ci>Ca_sr_bufsr</ci>
          <apply>
            <minus/>
            <ci>i_up</ci>
            <apply>
              <plus/>
              <ci>i_rel</ci>
              <ci>i_leak</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>Ca_sr_bufsr</ci>
        <apply>
          <divide/>
          <cn cellml:units="dimensionless">1.0</cn>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1.0</cn>
            <apply>
              <divide/>
              <apply>
                <times/>
                <ci>Buf_sr</ci>
                <ci>K_buf_sr</ci>
              </apply>
              <apply>
                <power/>
                <apply>
                  <plus/>
                  <ci>Ca_sr</ci>
                  <ci>K_buf_sr</ci>
                </apply>
                <cn cellml:units="dimensionless">2.0</cn>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>time</ci>
          </bvar>
          <ci>Ca_ss</ci>
        </apply>
        <apply>
          <times/>
          <ci>Ca_ss_bufss</ci>
          <apply>
            <minus/>
            <apply>
              <plus/>
              <apply>
                <divide/>
                <apply>
                  <times/>
                  <apply>
                    <minus/>
                    <ci>ICaL</ci>
                  </apply>
                  <ci>Cm</ci>
                </apply>
                <apply>
                  <times/>
                  <apply>
                    <times/>
                    <cn cellml:units="dimensionless">2.0</cn>
                    <ci>V_ss</ci>
                  </apply>
                  <ci>F</ci>
                </apply>
              </apply>
              <apply>
                <divide/>
                <apply>
                  <times/>
                  <ci>i_rel</ci>
                  <ci>V_sr</ci>
                </apply>
                <ci>V_ss</ci>
              </apply>
            </apply>
            <apply>
              <divide/>
              <apply>
                <times/>
                <ci>i_xfer</ci>
                <ci>Vc</ci>
              </apply>
              <ci>V_ss</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>Ca_ss_bufss</ci>
        <apply>
          <divide/>
          <cn cellml:units="dimensionless">1.0</cn>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1.0</cn>
            <apply>
              <divide/>
              <apply>
                <times/>
                <ci>Buf_ss</ci>
                <ci>K_buf_ss</ci>
              </apply>
              <apply>
                <power/>
                <apply>
                  <plus/>
                  <ci>Ca_ss</ci>
                  <ci>K_buf_ss</ci>
                </apply>
                <cn cellml:units="dimensionless">2.0</cn>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>ItCa</ci>
        <apply>
          <minus/>
          <apply>
            <plus/>
            <apply>
              <plus/>
              <ci>ICaB</ci>
              <ci>IpCa</ci>
            </apply>
            <ci>ICaL</ci>
          </apply>
          <apply>
            <times/>
            <cn cellml:units="dimensionless">2.0</cn>
            <ci>INaCa</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>O</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <times/>
              <ci>calcium_O_k1</ci>
              <apply>
                <power/>
                <ci>Ca_ss</ci>
                <cn cellml:units="dimensionless">2.0</cn>
              </apply>
            </apply>
            <ci>R_prime</ci>
          </apply>
          <apply>
            <plus/>
            <ci>calcium_O_k3</ci>
            <apply>
              <times/>
              <ci>calcium_O_k1</ci>
              <apply>
                <power/>
                <ci>Ca_ss</ci>
                <cn cellml:units="dimensionless">2.0</cn>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>time</ci>
          </bvar>
          <ci>R_prime</ci>
        </apply>
        <apply>
          <plus/>
          <apply>
            <times/>
            <apply>
              <times/>
              <apply>
                <minus/>
                <ci>calcium_R_prime_k2</ci>
              </apply>
              <ci>Ca_ss</ci>
            </apply>
            <ci>R_prime</ci>
          </apply>
          <apply>
            <times/>
            <ci>calcium_R_prime_k4</ci>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1.0</cn>
              <ci>R_prime</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>calcium_O_k1</ci>
        <apply>
          <divide/>
          <ci>k1_prime</ci>
          <ci>kcasr</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>calcium_R_prime_k2</ci>
        <apply>
          <times/>
          <ci>k2_prime</ci>
          <ci>kcasr</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>i_leak</ci>
        <apply>
          <times/>
          <ci>V_leak</ci>
          <apply>
            <minus/>
            <ci>Ca_sr</ci>
            <ci>Ca_i</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>i_rel</ci>
        <apply>
          <times/>
          <apply>
            <times/>
            <ci>V_rel</ci>
            <ci>O</ci>
          </apply>
          <apply>
            <minus/>
            <ci>Ca_sr</ci>
            <ci>Ca_ss</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>i_up</ci>
        <apply>
          <divide/>
          <ci>Vmax_up</ci>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1.0</cn>
            <apply>
              <divide/>
              <apply>
                <power/>
                <ci>K_up</ci>
                <cn cellml:units="dimensionless">2.0</cn>
              </apply>
              <apply>
                <power/>
                <ci>Ca_i</ci>
                <cn cellml:units="dimensionless">2.0</cn>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>i_xfer</ci>
        <apply>
          <times/>
          <ci>V_xfer</ci>
          <apply>
            <minus/>
            <ci>Ca_ss</ci>
            <ci>Ca_i</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>kcasr</ci>
        <apply>
          <minus/>
          <ci>max_sr</ci>
          <apply>
            <divide/>
            <apply>
              <minus/>
              <ci>max_sr</ci>
              <ci>min_sr</ci>
            </apply>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">1.0</cn>
              <apply>
                <power/>
                <apply>
                  <divide/>
                  <ci>EC</ci>
                  <ci>Ca_sr</ci>
                </apply>
                <cn cellml:units="dimensionless">2.0</cn>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
  <component name="cell">
    <variable name="type" units="dimensionless" public_interface="out" initial_value="1.0"/>
  </component>
  <component name="engine">
    <variable name="time" units="ms" public_interface="out" cmeta:id="engine_time"/>
  </component>
  <component name="extra">
    <variable name="Cao" units="mM" public_interface="out" initial_value="2.0"/>
    <variable name="Ko" units="mM" public_interface="out" initial_value="5.4"/>
    <variable name="Nao" units="mM" public_interface="out" initial_value="140.0"/>
  </component>
  <component name="icab">
    <variable name="ECa" units="mV" public_interface="in"/>
    <variable name="ICaB" units="A_per_F" public_interface="out"/>
    <variable name="V" units="mV" public_interface="in"/>
    <variable name="g_bca" units="mS_per_uF"/>
    <variable name="scale_in" units="dimensionless" initial_value="1.51992"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>ICaB</ci>
        <apply>
          <times/>
          <ci>g_bca</ci>
          <apply>
            <minus/>
            <ci>V</ci>
            <ci>ECa</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>g_bca</ci>
        <apply>
          <times/>
          <ci>scale_in</ci>
          <cn cellml:units="mS_per_uF">0.000592</cn>
        </apply>
      </apply>
    </math>
  </component>
  <component name="ical">
    <variable name="Ca_ss" units="mM" public_interface="in"/>
    <variable name="Cao" units="mM" public_interface="in"/>
    <variable name="FFTR" units="dimensionless" public_interface="in"/>
    <variable name="FTR" units="dimensionless" public_interface="in"/>
    <variable name="ICaL" units="A_per_F" public_interface="out" cmeta:id="ical_ICaL"/>
    <variable name="V" units="mV" public_interface="in"/>
    <variable name="conductance_cal_compound" units="dimensionless" initial_value="1.0"/>
    <variable name="d" units="dimensionless" initial_value="3.30548499869733964e-05"/>
    <variable name="f" units="dimensionless" initial_value="9.77158843631106722e-01"/>
    <variable name="f2" units="dimensionless" initial_value="9.99406290178190937e-01"/>
    <variable name="fCass" units="dimensionless" initial_value="9.99972178434477055e-01"/>
    <variable name="gCaL" units="mS_per_uF" cmeta:id="ical_gCaL"/>
    <variable name="gamma" units="dimensionless"/>
    <variable name="ical_d_alpha" units="dimensionless"/>
    <variable name="ical_d_beta" units="dimensionless"/>
    <variable name="ical_d_inf" units="dimensionless"/>
    <variable name="ical_d_tau" units="dimensionless"/>
    <variable name="ical_f2_inf" units="dimensionless"/>
    <variable name="ical_f2_tau" units="dimensionless"/>
    <variable name="ical_fCass_inf" units="m6_per_mol2"/>
    <variable name="ical_fCass_tau" units="m6_per_mol2"/>
    <variable name="ical_f_inf" units="dimensionless"/>
    <variable name="ical_f_tau" units="dimensionless"/>
    <variable name="p1" units="dimensionless"/>
    <variable name="p2" units="mM"/>
    <variable name="p3" units="dimensionless"/>
    <variable name="p4" units="dimensionless" cmeta:id="ical_p4"/>
    <variable name="scale_cal" units="dimensionless" initial_value="4.12823" cmeta:id="ical_scale_cal"/>
    <variable name="scale_tau_f" units="dimensionless" initial_value="0.309265"/>
    <variable name="time" units="ms" public_interface="in"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>ICaL</ci>
        <piecewise>
          <piece>
            <apply>
              <divide/>
              <apply>
                <times/>
                <ci>p1</ci>
                <apply>
                  <minus/>
                  <ci>p2</ci>
                  <ci>p4</ci>
                </apply>
              </apply>
              <ci>p3</ci>
            </apply>
            <apply>
              <eq/>
              <ci>V</ci>
              <cn cellml:units="dimensionless">15.0</cn>
            </apply>
          </piece>
          <otherwise>
            <apply>
              <divide/>
              <apply>
                <times/>
                <apply>
                  <times/>
                  <ci>p1</ci>
                  <apply>
                    <minus/>
                    <ci>V</ci>
                    <cn cellml:units="dimensionless">15.0</cn>
                  </apply>
                </apply>
                <apply>
                  <minus/>
                  <apply>
                    <times/>
                    <ci>p2</ci>
                    <apply>
                      <exp/>
                      <apply>
                        <times/>
                        <ci>p3</ci>
                        <apply>
                          <minus/>
                          <ci>V</ci>
                          <cn cellml:units="dimensionless">15.0</cn>
                        </apply>
                      </apply>
                    </apply>
                  </apply>
                  <ci>p4</ci>
                </apply>
              </apply>
              <apply>
                <minus/>
                <apply>
                  <exp/>
                  <apply>
                    <times/>
                    <ci>p3</ci>
                    <apply>
                      <minus/>
                      <ci>V</ci>
                      <cn cellml:units="dimensionless">15.0</cn>
                    </apply>
                  </apply>
                </apply>
                <cn cellml:units="dimensionless">1.0</cn>
              </apply>
            </apply>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>time</ci>
          </bvar>
          <ci>d</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>ical_d_inf</ci>
            <ci>d</ci>
          </apply>
          <ci>ical_d_tau</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>time</ci>
          </bvar>
          <ci>f</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>ical_f_inf</ci>
            <ci>f</ci>
          </apply>
          <ci>ical_f_tau</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>time</ci>
          </bvar>
          <ci>f2</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>ical_f2_inf</ci>
            <ci>f2</ci>
          </apply>
          <ci>ical_f2_tau</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>time</ci>
          </bvar>
          <ci>fCass</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>ical_fCass_inf</ci>
            <ci>fCass</ci>
          </apply>
          <ci>ical_fCass_tau</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>gCaL</ci>
        <apply>
          <times/>
          <apply>
            <times/>
            <ci>conductance_cal_compound</ci>
            <ci>scale_cal</ci>
          </apply>
          <cn type="e-notation" cellml:units="mS_per_uF">3.98<sep/>-5</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>gamma</ci>
